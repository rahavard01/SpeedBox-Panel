  "name": "panel",
  "version": "3.0",
  "panelRelease": {
    "title": "به‌روزرسانی پنل",
    "changes": [
      "مدیریت کاربران، نمایندگان، اشتراک‌ها و سرورها در یک پروژه",
      "نمایش تعداد IPهای آنلاین در بخش‌های مدیریت کاربران و لیست اشتراک؛ همراه بهبود نمایش اطلاعات داشبورد.",
      "مشاهدهٔ سوابق بازنشانی ترافیک، نمایش تعداد و زمان آخرین و بازنشانی بعدی.",
      "ساخت کاربر با نام کاربری دلخواه",
      "تنظیم و مدیریت سوالات متداول ربات از داخل پنل برای هر نماینده"
    ]
  },
  "private": true,
